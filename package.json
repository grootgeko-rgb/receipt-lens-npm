{
  "name": "@receipt-lens/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-first in-browser receipt parsing: staged OCR, deterministic parsing, conditional validation.",
  "keywords": [
    "receipt",
    "ocr",
    "parser",
    "browser",
    "privacy",
    "onnx",
    "onnxruntime-web",
    "bill-split",
    "expenses",
    "typescript"
  ],
  "author": "geko-rgb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geko-rgb/receipt-lens-npm.git"
  },
  "bugs": {
    "url": "https://github.com/geko-rgb/receipt-lens-npm/issues"
  },
  "homepage": "https://github.com/geko-rgb/receipt-lens-npm#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc -p . && node scripts/emit-dom-reference.mjs",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
